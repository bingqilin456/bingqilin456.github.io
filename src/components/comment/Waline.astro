---
import { commentConfig } from "@/config";
import Key from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	path: string;
}

// 未配置服务地址时不挂载联网客户端：空 serverURL 会让 Waline 把请求落到当前站点域名
const isConfigured = Boolean(commentConfig.waline?.serverURL);

const config = {
	...commentConfig.waline,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	wordLimit: ["2", "300"],
	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
{isConfigured ? (
  <div class="relative w-full">
    <div id="waline"></div>
    <link rel="stylesheet" href="https://unpkg.com/@waline/client@3.15.2/dist/waline.css" />
    <script type="module" is:inline define:vars={{ config }}>
      const cdnUrls = [
        'https://unpkg.com/@waline/client@3.15.2/dist/waline.js',
        'https://cdn.jsdelivr.net/npm/@waline/client@3.15.2/dist/waline.js'
      ];

      async function loadWaline(urls) {
        for (const url of urls) {
          try {
            const { init } = await import(url);
            init(config);
            return;
          } catch (error) {
            console.warn(`Failed to load Waline from ${url}:`, error);
          }
        }
        console.error('Failed to load Waline from all CDN sources');
      }

      loadWaline(cdnUrls);
    </script>
  </div>
) : (
  <div class="text-center py-8 text-(--content-meta)">
    <p>{i18n(Key.commentNotConfigured)}</p>
  </div>
)}
