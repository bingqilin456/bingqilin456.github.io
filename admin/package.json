    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.3.0",
    "lucide-react": "^1.0.0",
    "marked": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
