  "type": "module",
  "version": "1.0.0",
  "engines": { "node": ">=24.0.0" },
  "imports": { "#shared/*": "./shared/*.ts", "#worker/*": "./worker/*.ts" },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "wrangler dev --local --port 8787",
