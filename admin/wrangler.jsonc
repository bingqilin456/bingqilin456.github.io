{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bql-blog-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    "GITHUB_OWNER": "bingqilin456", "GITHUB_REPO": "", "GITHUB_BRANCH": "master",
    "BLOG_URL": "https://bingqilin456.github.io/", "APP_ORIGIN": "http://127.0.0.1:5173",
    "GITHUB_CLIENT_ID": "", "ALLOWED_GITHUB_USERS": "bingqilin456"
  }
}
